# Variables de Entorno - Copiloto Lucía

# Configuración de DeepSeek (LLM)
# Ingresa tu API Key aquí para habilitar la generación de texto real
DEEPSEEK_API_KEY=sk-tu-api-key-de-deepseek-aqui

# Cambia esto a True si quieres desarrollar sin usar las APIs reales (Datos simulados)
USE_MOCK_LLM=False
USE_MOCK_RAG=False

# Base de datos Transaccional (Cambiar a Supabase PostgreSQL para entorno compartido)
# Ej: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./lucia_brain.db

# Cuenta financiera (FINANCIAL_ACCOUNT del dataset real) que usan los canales
# externos cuando no logran identificar al cliente: por ejemplo, un número de
# WhatsApp que no está en contactos_usuario, o el bot de Telegram.
# Si se deja vacío, el backend elige automáticamente una cuenta con historial.
DEMO_ACCOUNT_ID=

# =============================================
# Capa RAG (Supabase)
# =============================================
SUPABASE_URL=tu_supabase_url
SUPABASE_KEY=tu_supabase_anon_key
OPENAI_API_KEY=sk-tu-api-key-de-openai-para-embeddings

# =============================================
# Capa RAG - Supabase (pgvector)
# =============================================
# URL del proyecto: Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave de API. Se RECOMIENDA la clave service_role (solo backend, omite RLS).
# Nunca publiques la service_role key en el frontend ni la subas al repositorio.
SUPABASE_KEY=tu-anon-or-service-role-key

# True = RAG simulado (no requiere credenciales). False = consulta real a Supabase.
USE_MOCK_RAG=False

# Proveedor de embeddings: "local" (384 dims, sin API ni costo) u "openai" (1536 dims).
# La dimensión debe coincidir con la declarada en scripts/setup_supabase.sql.
EMBEDDING_PROVIDER=local

# Modelo de embeddings. Déjalo vacío para usar el por defecto del proveedor
# (all-MiniLM-L6-v2 para local, text-embedding-3-small para openai).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Clave de OpenAI SOLO para embeddings, y SOLO si EMBEDDING_PROVIDER=openai.
# DEEPSEEK_API_KEY no sirve aquí: DeepSeek no tiene endpoint de embeddings
# (su API expone únicamente chat completions).
OPENAI_API_KEY=

# Umbral de similitud (0-1) y cantidad de chunks a recuperar (top-k).
RAG_MATCH_THRESHOLD=0.5
RAG_MATCH_COUNT=3

# =============================================
# WhatsApp Cloud API (Meta for Developers)
# =============================================
# Token temporal de tu App en Meta for Developers > WhatsApp > API Setup
WHATSAPP_TOKEN=tu_whatsapp_access_token_aqui

# ID del número de teléfono en Meta for Developers > WhatsApp > API Setup > Phone number ID
WHATSAPP_PHONE_ID=tu_phone_number_id_aqui

# Token secreto que INVENTES TÚ para validar el Webhook. Debe coincidir con lo que
# pongas en Meta for Developers > WhatsApp > Configuration > Webhook > Verify Token.
WHATSAPP_VERIFY_TOKEN=lucia_hackathon_secret

# App Secret de tu app de Meta (App Settings > Basic > App Secret).
# Habilita la verificación de la firma X-Hub-Signature-256 de los eventos
# entrantes. Sin esto, cualquiera que conozca la URL del webhook puede inyectar
# mensajes falsos. Si se deja vacío, el webhook acepta todo y avisa en el log.
WHATSAPP_APP_SECRET=

# Versión de la Graph API. Meta retira las versiones antiguas (v17.0 ya no sirve).
# Copia la que muestre el ejemplo de curl en WhatsApp > API Setup.
WHATSAPP_API_VERSION=v26.0

# =============================================
# Telegram Bot
# =============================================
# Token que te da @BotFather en Telegram al crear un bot (/newbot)
TELEGRAM_TOKEN=tu_telegram_bot_token_aqui
